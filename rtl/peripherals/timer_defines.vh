`ifndef TIMER_DEFINES_VH
`define TIMER_DEFINES_VH

// Register Byte Offsets
`define TIMER_REG_CTRL       8'h00
`define TIMER_REG_RELOAD     8'h04
`define TIMER_REG_COUNT      8'h08

// Bit fields
`define TIMER_CTRL_EN_BIT    0


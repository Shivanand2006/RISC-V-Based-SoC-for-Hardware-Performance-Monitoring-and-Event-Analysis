addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/u_soc_top/u_cycle_cnt/shadow_hi_q[31:0]
addGroup "04_Instruction_Counter_IP"
addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/u_soc_top/u_instr_cnt/count_q[63:0]
addSignal -h 15 /tb_soc_top/u_soc_top/u_instr_cnt/en_q

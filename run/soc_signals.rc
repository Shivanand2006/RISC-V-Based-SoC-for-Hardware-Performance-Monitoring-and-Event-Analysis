addSignal -h 15 /tb_soc_top/u_soc_top/u_veer_core_adapter/trace_rv_i_valid_ip
addGroup "03_Cycle_Counter_IP"
addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/u_soc_top/u_cycle_cnt/count_q[63:0]

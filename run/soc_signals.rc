Magic 271485
addGroup "01_Testbench_Status"
activeDirFile "" "/home/student/1602-23-735-108/tb_soc_top.fsdb"
addSignal -h 15 /tb_soc_top/clk
addSignal -h 15 -holdScope rst_n
addSignal -h 15 -holdScope cycle_idx[31:0]
addSignal -h 15 -holdScope pass_seen
addSignal -h 15 -holdScope fail_seen
addSignal -h 15 -holdScope gpio_out[7:0]
addGroup "02_CPU_Core_Execution"
addSignal -h 15 /tb_soc_top/u_soc_top/core_instr_retire

addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/u_soc_top/u_instr_cnt/shadow_hi_q[31:0]
addGroup "05_Performance_Event_Counter_IP"
addSignal -h 15 -UNSIGNED -HEX /tb_soc_top/u_soc_top/u_event_cnt/count_q[31:0]
addSignal -h 15 -UNSIGNED /tb_soc_top/u_soc_top/u_event_cnt/evt_sel_q[2:0]
addSignal -h 15 /tb_soc_top/u_soc_top/u_event_cnt/en_q
addSignal -h 15 /tb_soc_top/u_soc_top/u_event_cnt/thresh_hit_q
addSignal -h 15 /tb_soc_top/u_soc_top/events[7:0]
addGroup "06_SoC_Data_Bus"
addSignal -h 15 /tb_soc_top/u_soc_top/core_dmem_req
addSignal -h 15 /tb_soc_top/u_soc_top/core_dmem_we
